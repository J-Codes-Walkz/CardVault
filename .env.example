# Copy this file to .env and fill in real values. .env itself is
# listed in .gitignore and must never be committed.
#
# Generate SECRET_KEY with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# True only on your own machine. Must be False (or unset) everywhere
# else, including Heroku.
DEBUG=True

# Local PostgreSQL connection. Heroku sets DATABASE_URL itself when
# you provision the Postgres add-on, so you do not set this one on
# Heroku.
DATABASE_URL=postgres://YOUR_USER:YOUR_PASSWORD@localhost:5432/cardvault

# Comma-separated hostnames. Not needed locally while DEBUG=True.
# On Heroku: your-app-name.herokuapp.com
ALLOWED_HOSTS=
