# Secrets: real values live only in .env locally and in Heroku config
# vars. No .env file of any kind is committed.
.env
.env.*

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Django
*.sqlite3
/staticfiles/
/media/

# Test coverage
.coverage
htmlcov/

# Editors and operating systems
.vscode/
.idea/
.DS_Store

# Logs
*.log

# Knowledge graph: only the three shareable outputs are tracked; the
# cache and machine-specific files stay local.
graphify-out/*
!graphify-out/graph.html
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md
